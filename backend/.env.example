# Copy this file to backend/.env and fill in your own key.
# Get a Gemini API key from Google AI Studio, then:
#   cp backend/.env.example backend/.env
# The chatbot (Carlos) reads GEMINI_API_KEY via dotenv in server.js.
# On a hosted backend (Render/Railway/etc), set GEMINI_API_KEY in the
# host's environment-variable dashboard instead — never commit a real key.
GEMINI_API_KEY=YOUR_API_KEY_HERE
